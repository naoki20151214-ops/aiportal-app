# Public origin for canonical, Open Graph URLs, and sitemap.xml.
# Production origin. Override only when using a different site origin.
SITE_URL=https://aiportal.blog

# Master switch for display ads AND affiliates. Changes require a production rebuild.
ADS_ENABLED=false
# Separate opt-in for affiliates; ADS_ENABLED must also be true.
AFFILIATES_ENABLED=false
